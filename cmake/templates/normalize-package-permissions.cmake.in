if(NOT IS_DIRECTORY "${CPACK_TEMPORARY_INSTALL_DIRECTORY}")
    message(FATAL_ERROR "CPack staging directory is missing: ${CPACK_TEMPORARY_INSTALL_DIRECTORY}")
endif()

execute_process(
    COMMAND @APP_SETFACL_EXECUTABLE@ -R -b -k "${CPACK_TEMPORARY_INSTALL_DIRECTORY}"
    COMMAND_ERROR_IS_FATAL ANY
)
execute_process(
    COMMAND chmod -R u+rwX,go+rX,go-w "${CPACK_TEMPORARY_INSTALL_DIRECTORY}"
    COMMAND_ERROR_IS_FATAL ANY
)